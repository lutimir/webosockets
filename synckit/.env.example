# ─── Server ──────────────────────────────────────────────────────────────────
# Port and host the Fastify server (REST + WebSocket gateway) binds to.
PORT=4000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://synckit:synckit@localhost:5432/synckit

# ─── Redis ───────────────────────────────────────────────────────────────────
# Used for pub/sub fan-out between server instances and presence storage.
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret for signing client JWTs handed out via POST /v1/tokens (HS256).
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000

# Secret protecting /internal/* routes used by the dashboard (never exposed to SDKs).
INTERNAL_API_SECRET=dev-only-change-me-1111111111111111

# ─── Dashboard ───────────────────────────────────────────────────────────────
# Origin of the dashboard app, used for CORS on the server.
DASHBOARD_ORIGIN=http://localhost:3000
# Server URL the dashboard and demo talk to (browser-visible).
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys. Optional in dev;
# billing features are disabled when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
