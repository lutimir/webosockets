# ─── Server ──────────────────────────────────────────────────────────────────
# Port and host the Fastify server (REST + WebSocket gateway) binds to.
PORT=4000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://synckit:synckit@localhost:5432/synckit

# ─── Redis ───────────────────────────────────────────────────────────────────
# Used for pub/sub fan-out between server instances and presence storage.
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret for signing client JWTs handed out via POST /v1/tokens (HS256).
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000

# Secret protecting /internal/* routes used by the dashboard (never exposed to SDKs).
INTERNAL_API_SECRET=dev-only-change-me-1111111111111111

# ─── Realtime tuning (optional — sane defaults built in) ────────────────────
# Server ping interval; a connection is terminated after 2 missed pongs.
#WS_HEARTBEAT_INTERVAL_MS=30000
# Concurrent connection limits.
#WS_MAX_CONNECTIONS_PER_END_USER=5
#WS_MAX_CONNECTIONS_PER_PROJECT=1000
# Messages per second per connection (token bucket).
#WS_RATE_LIMIT_PER_SEC=50
# Backpressure: above soft limit messages are dropped, above hard the socket closes.
#WS_BACKPRESSURE_SOFT_BYTES=1048576
#WS_BACKPRESSURE_HARD_BYTES=5242880
# Presence hash TTL — protects against crashed instances leaving ghosts.
#PRESENCE_TTL_SECONDS=300

# ─── Dashboard ───────────────────────────────────────────────────────────────
# Origin of the dashboard app, used for CORS on the server and invite links.
DASHBOARD_ORIGIN=http://localhost:3000
# Where the dashboard reaches the server's /internal API (server-side only).
SERVER_INTERNAL_URL=http://localhost:4000
# Server URL the dashboard and demo talk to (browser-visible).
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys. Optional in dev;
# billing features are disabled when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
