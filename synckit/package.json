{
  "name": "synckit",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @synckit/server db:migrate",
    "db:seed": "pnpm --filter @synckit/server db:seed",
    "docs:reference": "typedoc --entryPoints packages/client/src/index.ts --out apps/docs/content/reference/client && typedoc --entryPoints packages/react/src/index.ts --out apps/docs/content/reference/react"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@synckit/config": "workspace:*",
    "eslint": "^9.39.0",
    "prettier": "^3.8.4",
    "turbo": "^2.8.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "nextra>zod": "4.1.13",
      "nextra-theme-docs>zod": "4.1.13"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
