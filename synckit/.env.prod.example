# Copy to .env next to docker-compose.prod.yml and fill in real values.
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-32-chars-minimum-random-secret
INTERNAL_API_SECRET=change-me-32-chars-minimum-random-secret
DASHBOARD_ORIGIN=http://localhost:3000

# Demo app: mint an API key in the dashboard, then paste it here.
DEMO_API_KEY=
DEMO_WS_URL=ws://localhost:8080/v1/realtime

# Optional — billing stays disabled when empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
