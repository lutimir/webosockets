{
  "name": "@synckit/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "echo 'db:migrate — migrations arrive in Prompt 2' && exit 0",
    "db:seed": "echo 'db:seed — seeding arrives in Prompt 2' && exit 0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@synckit/core": "workspace:*",
    "fastify": "^5.7.4",
    "ioredis": "^5.9.1",
    "postgres": "^3.4.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@synckit/config": "workspace:*",
    "@types/node": "^22.19.11",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
